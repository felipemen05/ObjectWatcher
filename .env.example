# ==============================================================================
# ObjectWatcher - Configurações de Ambiente (ObjectData)
# ==============================================================================

# Opção 1: Webhook do canal do Discord (Mais simples e recomendado)
# Crie em: Canal do Discord > Editar Canal > Integrações > Webhooks > Novo Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_WEBHOOK_AQUI/SEU_TOKEN_AQUI

# Opção 2: Discord Bot Token (Alternativa usando Bot Application)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Nome de exibição do Bot no Discord (Padrão: ObjectWatcher)
DISCORD_BOT_NAME=ObjectWatcher

# URL da imagem de avatar do Bot (Logotipo da ObjectData ou imagem pública)
# Dica: Você pode hospedar a imagem no Imgur, Cloudinary ou no próprio repositório GitHub
DISCORD_AVATAR_URL=https://raw.githubusercontent.com/objectdata/objectwatcher/main/Foto_perfil.jpg

# Anexar arquivos oficiais diretamente na mensagem do Discord (PDFs de NTs, ZIPs de Schemas XML)
# Opções: true / false (Padrão: true - salva o arquivo direto no histórico do canal)
ATTACH_FILES_TO_DISCORD=true

# Tamanho máximo do arquivo para upload no Discord em Megabytes (Limite do webhook é 25MB)
MAX_ATTACHMENT_SIZE_MB=25

# Salvar cópia local dos arquivos baixados organizada por data (ex: downloads/2026-11-09/arquivo.pdf)
SAVE_LOCAL_ARCHIVE=true
ARCHIVE_DIR=downloads

# Chave de API do Google Gemini (Opcional, mas altamente recomendada)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
# Se não preenchida, o bot usará um motor heurístico inteligente baseado em regras locais.
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado (Padrão: gemini-3.8-flash ou gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Caminho do banco de dados SQLite para controle de deduplicação
DATABASE_PATH=data/objectwatcher.db

# Intervalo padrão de checagem em minutos quando executado em modo contínuo (--loop)
CHECK_INTERVAL_MINUTES=60

# Nível de Log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
